{
  "name": "goals-app",
  "version": "2.6.6",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate || echo 'skip prisma generate: schema not present in this install layer; prebuild will generate it'",
    "predev": "rm -rf .next",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:server": "vitest run --project server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "release": "node scripts/release.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:lib": "vitest run --project lib",
    "reindex": "tsx --conditions react-server --env-file-if-exists=.env.local scripts/reindex.ts"
  },
  "dependencies": {
    "@ai-sdk/langchain": "^3.0.48",
    "@ai-sdk/react": "^4.0.51",
    "@base-ui/react": "^1.6.0",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.5.18",
    "@langchain/classic": "^1.0.40",
    "@langchain/core": "^1.2.4",
    "@langchain/deepseek": "^1.1.5",
    "@langchain/openai": "^1.5.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.48",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langchain": "^1.5.4",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@clerk/testing": "^2.2.8",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
